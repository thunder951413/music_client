<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait player in the Apple Music manner: cover, title, progress and three transport
     controls. Speed, audio details, sleep timer and rating live in the overflow menu, shuffle and
     repeat in the queue. Hidden views stay so the menu can still trigger their actions. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_media_controller_layout"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/player_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            style="@style/PlayerIconButton"
            android:id="@+id/player_collapse_button"
            android:contentDescription="@string/player_collapse"
            app:srcCompat="@drawable/player_collapse" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_now_playing"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/player_context_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/player_overflow_button"
            style="@style/PlayerIconButton"
            android:background="@drawable/player_round_surface"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:padding="7dp"
            android:src="@drawable/ic_more_horiz"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/player_more_options" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_media_quality_sector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/player_toolbar">
        <Button
            android:id="@+id/player_playback_speed_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_48sdp"
            android:textSize="@dimen/_12sdp"
            android:textColor="?attr/colorPrimary"
            app:cornerRadius="30dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/player_info_track"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_50sdp"
            android:padding="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/player_media_quality_sector_center"
            app:layout_constraintBottom_toBottomOf="@id/player_media_quality_sector_center"
            app:srcCompat="@drawable/ic_info_stream"
            app:tint="?attr/colorPrimary" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_media_quality_sector_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:id="@+id/player_media_bitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="?attr/colorSurface"
                app:layout_constraintTop_toTopOf="@id/player_media_extension"
                app:layout_constraintBottom_toBottomOf="@id/player_media_extension"
                app:layout_constraintStart_toEndOf="@id/player_media_extension"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/player_media_extension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:checked="true"
                android:focusable="true"
                android:text="Unknown"
                android:textSize="@dimen/_12sdp"
                app:chipStrokeWidth="0dp"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/player_media_bitrate"
                app:layout_constraintHorizontal_chainStyle="packed" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/player_asset_link_row"
        layout="@layout/view_asset_link_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_media_quality_sector"
        android:visibility="gone" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/player_media_cover_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_asset_link_row"
        app:layout_constraintWidth_max="460dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.585" />

    <TextView
        android:id="@+id/player_media_title_label"
        style="@style/PlayerSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="@string/label_placeholder"
        app:layout_constraintEnd_toStartOf="@+id/player_favorite_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline" />

    <TextView
        android:id="@+id/player_artist_name_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="@string/label_placeholder"
        app:layout_constraintEnd_toStartOf="@+id/player_favorite_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_media_title_label" />

    <FrameLayout
        android:id="@+id/player_favorite_surface"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/player_round_surface"
        app:layout_constraintBottom_toBottomOf="@+id/player_artist_name_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_media_title_label">
        <androidx.appcompat.widget.AppCompatToggleButton
            android:id="@+id/button_favorite"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/player_favorite_refined"
            android:backgroundTint="?attr/colorOnSurface"
            android:checked="false"
            android:text=""
            android:textOff=""
            android:textOn=""
            android:contentDescription="@string/player_queue_starred" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rating_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:transformPivotX="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_artist_name_label">
        <RatingBar
            android:id="@+id/song_rating_bar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="0"
            android:isIndicator="false" />

        <TextView
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="" />
    </LinearLayout>

    <com.eddyizm.tempus.ui.player.SmoothTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rating_container" />

    <TextView
        android:id="@+id/exo_position"
        style="@style/PlayerTimeLabel"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <TextView
        android:id="@+id/exo_duration"
        style="@style/PlayerTimeLabel"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <ImageButton
        android:id="@id/exo_play_pause"
        style="@style/PlayerHeroButton"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_position"
        app:layout_constraintVertical_bias="0.42" />

    <ImageButton
        android:id="@+id/exo_prev"
        style="@style/PlayerHeroButton"
        android:layout_marginEnd="28dp"
        app:srcCompat="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintEnd_toStartOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/exo_rew"
        style="@style/PlayerHeroButton"
        android:layout_marginEnd="28dp"
        android:src="@drawable/ic_replay"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintEnd_toStartOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/exo_next"
        style="@style/PlayerHeroButton"
        android:layout_marginStart="28dp"
        app:srcCompat="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintStart_toEndOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/exo_ffwd"
        style="@style/PlayerHeroButton"
        android:layout_marginStart="28dp"
        app:srcCompat="@drawable/ic_forward"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintStart_toEndOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ToggleButton
        android:id="@+id/player_skip_silence_toggle_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/button_skip_silence_selector"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <LinearLayout
        android:id="@+id/player_sleep_timer_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="2dp">
        <ImageButton
            android:id="@+id/player_sleep_timer_button"
            style="@style/PlayerIconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_timer"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/sleep_timer_dialog_title" />

        <TextView
            android:id="@+id/player_sleep_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_quick_action_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/player_play_mode_button"
            style="@style/PlayerIconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/player_round_surface"
            android:contentDescription="@string/player_mode_repeat_all"
            app:srcCompat="@drawable/ic_repeat"
            app:tint="@color/player_foreground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_open_lyrics_button"
            style="@style/PlayerPillButton"
            android:layout_marginStart="8dp"
            android:text="@string/player_show_lyrics"
            app:icon="@drawable/ic_lyrics"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/player_play_mode_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_output_label"
            style="@style/PlayerPillButton"
            android:layout_marginEnd="8dp"
            android:maxWidth="140dp"
            android:text="@string/player_local_output"
            app:icon="@drawable/ic_speaker"
            app:layout_constraintEnd_toStartOf="@id/player_open_queue_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_open_queue_button"
            style="@style/PlayerPillButton"
            android:text="@string/player_queue_title"
            app:icon="@drawable/ic_queue"
            android:contentDescription="@string/player_queue_playing_next"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
