<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_sheet_peek_height"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mini_player_card"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/mini_player_surface"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/player_header_media_cover_image"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/player_header_media_title_label"
            style="@style/LabelMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/player_foreground"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintEnd_toStartOf="@id/mini_player_actions_start"
            app:layout_constraintStart_toEndOf="@+id/player_header_media_cover_image"
            app:layout_constraintTop_toTopOf="@+id/player_header_media_cover_image"
            app:layout_constraintBottom_toTopOf="@+id/player_header_media_artist_label" />

        <TextView
            android:id="@+id/player_header_media_artist_label"
            style="@style/LabelSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textSize="13sp"
            android:textColor="@color/player_secondary"
            app:layout_constraintEnd_toStartOf="@id/mini_player_actions_start"
            app:layout_constraintStart_toEndOf="@+id/player_header_media_cover_image"
            app:layout_constraintTop_toBottomOf="@+id/player_header_media_title_label"
            app:layout_constraintBottom_toBottomOf="@+id/player_header_media_cover_image" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/player_header_remote_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editorial_menu_output_route"
            app:srcCompat="@drawable/ic_speaker"
            app:layout_constraintEnd_toStartOf="@id/player_header_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/player_header_seek_bar"
            app:tint="@color/player_secondary" />

        <View
            android:id="@+id/placeholder_right_view"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/player_header_bookmark_media_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:padding="10dp"
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintEnd_toStartOf="@id/player_header_rewind_media_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_bookmark_sync"
            app:tint="@color/player_foreground" />

        <ImageButton
            android:id="@+id/player_header_rewind_media_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:padding="10dp"
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintEnd_toStartOf="@id/player_header_remote_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_replay"
            app:tint="@color/player_foreground" />

        <ToggleButton
            android:id="@+id/player_header_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/mini_player_play_pause"
            android:checked="false"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:text=""
            android:textOff=""
            android:textOn=""
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintEnd_toStartOf="@+id/placeholder_right_view"
            app:layout_constraintTop_toTopOf="parent"
            android:backgroundTint="@color/player_brass"
            android:contentDescription="@string/player_queue_play" />

        <ImageButton
            android:id="@+id/player_header_next_media_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_skip_next"
            app:tint="@color/player_foreground"
            app:layout_constraintEnd_toEndOf="@id/placeholder_right_view"
            app:layout_constraintStart_toStartOf="@id/placeholder_right_view" />

        <ImageButton
            android:id="@+id/player_header_fast_forward_media_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:padding="10dp"
            app:layout_constraintBottom_toTopOf="@+id/player_header_seek_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_forward"
            app:tint="@color/player_foreground"
            app:layout_constraintEnd_toEndOf="@id/placeholder_right_view"
            app:layout_constraintStart_toStartOf="@id/placeholder_right_view" />

        <SeekBar
            android:id="@+id/player_header_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressTint="@color/player_brass"
            android:progressBackgroundTint="@color/player_track"
            android:thumb="@android:color/transparent"
            android:importantForAccessibility="no"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/mini_player_actions_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:barrierAllowsGoneWidgets="false"
            app:constraint_referenced_ids="player_header_button,player_header_remote_button,player_header_rewind_media_button,player_header_bookmark_media_button" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
