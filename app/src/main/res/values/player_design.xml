<resources>
    <!-- Editorial Warm Dark ("唱片店夜色"): full-screen player stays dark in both app themes. -->
    <color name="player_bg">#0E0D0C</color>
    <color name="player_surface_1">#161412</color>
    <color name="player_surface_2">#1E1B18</color>
    <color name="player_surface_3">#28241F</color>
    <color name="player_frosted_capsule">#CC1E1B18</color>
    <color name="player_hairline">#14FFF0DC</color>
    <color name="player_ivory_outline">#66F2ECE3</color>

    <color name="player_foreground">#F2ECE3</color>
    <color name="player_secondary">#A3F2ECE3</color>
    <color name="player_tertiary">#66F2ECE3</color>
    <color name="player_brass">#CFA46A</color>
    <color name="player_brass_subtle">#1FCFA46A</color>
    <color name="player_brass_border">#80CFA46A</color>
    <color name="player_moss">#8DB596</color>
    <color name="player_moss_subtle">#228DB596</color>
    <color name="player_moss_border">#888DB596</color>
    <color name="player_terracotta">#D9785F</color>

    <color name="player_on_action">#0E0D0C</color>
    <color name="player_track">#29FFF0DC</color>
    <color name="player_control_surface">#CC1E1B18</color>

    <!-- Warm Paper mini-player palette for Light Mode -->
    <color name="player_mini_light_fg">#1D1A17</color>
    <color name="player_mini_light_secondary">#665F56</color>
    <color name="player_mini_light_brass">#9A7136</color>
    <color name="player_mini_light_hairline">#CFC6B9</color>
    <color name="player_mini_light_track">#261D1A17</color>

    <style name="PlayerIconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/player_foreground</item>
    </style>

    <style name="PlayerMainButton" parent="PlayerIconButton">
        <item name="android:layout_width">68dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/player_main_button</item>
        <item name="android:backgroundTint">@color/player_brass</item>
        <item name="tint">@color/player_on_action</item>
    </style>

    <style name="LibrarySectionTitle" parent="InterFontFamily">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="LibrarySectionEyebrow" parent="InterFontFamily">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="LibrarySectionAction" parent="InterFontFamily">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="PlayerSongTitle" parent="InterFontFamily">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/player_foreground</item>
    </style>

    <style name="PlayerHeroButton" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/player_foreground</item>
    </style>

    <style name="PlayerTimeLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/player_secondary</item>
    </style>

    <style name="PlayerSignalBadge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/player_secondary</item>
    </style>

    <style name="PlayerCapsuleAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PlayerPillButton" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/player_foreground</item>
        <item name="backgroundTint">@color/player_control_surface</item>
        <item name="iconTint">@color/player_foreground</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <string name="player_more_options">More options</string>
    <style name="PlayerAlbumShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <string name="player_now_playing">Now Playing</string>
    <string name="player_collapse">Close player</string>
    <string name="player_local_output">This device</string>
    <string name="player_remote_output">Remote playback</string>
    <string name="player_audio_details">Audio details</string>
    <string name="player_show_lyrics">Lyrics</string>
    <string name="player_queue_title">Queue</string>
    <string name="player_shuffle">Shuffle</string>
    <string name="player_repeat">Repeat</string>
    <string name="player_repeat_one">Repeat one</string>
    <string name="player_mode_sequential">Play in order, stop at the end</string>
    <string name="player_mode_repeat_all">Repeat queue</string>
    <string name="player_mode_repeat_one">Repeat this song</string>
    <string name="player_mode_shuffle">Shuffle</string>
</resources>
