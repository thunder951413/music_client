<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_media_controller_layout"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/player_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            style="@style/PlayerIconButton"
            android:id="@+id/player_collapse_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:contentDescription="@string/player_collapse"
            app:srcCompat="@drawable/player_collapse" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_now_playing"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textSize="11sp"
                android:textColor="@color/player_secondary" />

            <TextView
                android:id="@+id/player_context_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/player_foreground"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_top_output_pill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/editorial_menu_output_route">

            <ImageView
                android:id="@+id/player_top_output_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:srcCompat="@drawable/ic_speaker"
                app:tint="@color/player_foreground"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/player_top_output_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxWidth="160dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/player_foreground"
                android:text="@string/editorial_player_output_local" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/player_overflow_button"
            style="@style/PlayerIconButton"
            android:background="@drawable/player_round_surface"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_more_horiz"
            app:tint="@color/player_foreground"
            android:contentDescription="@string/player_more_options" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_media_quality_sector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_toolbar">

        <Button
            android:id="@+id/player_playback_speed_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/player_info_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_info_stream"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_media_quality_sector_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/player_media_bitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/player_media_extension" />

            <com.google.android.material.chip.Chip
                android:id="@+id/player_media_extension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/player_asset_link_row"
        layout="@layout/view_asset_link_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_media_quality_sector" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/player_media_cover_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_asset_link_row"
        app:layout_constraintWidth_max="500dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.56" />

    <TextView
        android:id="@+id/player_media_title_label"
        style="@style/PlayerSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="26sp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:text="@string/label_placeholder"
        app:layout_constraintEnd_toStartOf="@+id/player_favorite_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline" />

    <TextView
        android:id="@+id/player_artist_name_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="17sp"
        android:textColor="@color/player_secondary"
        android:text="@string/label_placeholder"
        app:layout_constraintEnd_toStartOf="@+id/player_favorite_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_media_title_label" />

    <FrameLayout
        android:id="@+id/player_favorite_surface"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/player_round_surface"
        app:layout_constraintBottom_toBottomOf="@+id/player_artist_name_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_media_title_label">

        <androidx.appcompat.widget.AppCompatToggleButton
            android:id="@+id/button_favorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/player_favorite_refined"
            android:backgroundTint="@color/player_foreground"
            android:checked="false"
            android:text=""
            android:textOff=""
            android:textOn=""
            android:contentDescription="@string/player_queue_starred" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/player_signal_badges_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_artist_name_label">

        <LinearLayout
            android:id="@+id/player_signal_badges_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/editorial_menu_signal_and_sound">

            <TextView
                android:id="@+id/player_badge_codec"
                style="@style/PlayerSignalBadge"
                android:layout_marginEnd="8dp"
                android:text="FLAC" />

            <TextView
                android:id="@+id/player_badge_rate"
                style="@style/PlayerSignalBadge"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_badge_rg"
                style="@style/PlayerSignalBadge"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_badge_eq"
                style="@style/PlayerSignalBadge"
                android:text="@string/editorial_badge_eq_flat" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/rating_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:transformPivotX="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_signal_badges_scroll">

        <RatingBar
            android:id="@+id/song_rating_bar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="0"
            android:isIndicator="false" />

        <TextView
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="@color/player_secondary"
            android:text="" />
    </LinearLayout>

    <com.eddyizm.tempus.ui.player.SmoothTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rating_container" />

    <TextView
        android:id="@+id/exo_position"
        style="@style/PlayerTimeLabel"
        android:layout_marginStart="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <TextView
        android:id="@+id/exo_duration"
        style="@style/PlayerTimeLabel"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <ImageButton
        android:id="@id/exo_play_pause"
        style="@style/PlayerMainButton"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:padding="19dp"
        app:tint="@color/player_on_action"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_position" />

    <ImageButton
        android:id="@+id/exo_prev"
        style="@style/PlayerHeroButton"
        android:layout_marginEnd="32dp"
        app:srcCompat="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintEnd_toStartOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/exo_rew"
        style="@style/PlayerHeroButton"
        android:layout_marginEnd="32dp"
        android:src="@drawable/ic_replay"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintEnd_toStartOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/exo_next"
        style="@style/PlayerHeroButton"
        android:layout_marginStart="32dp"
        app:srcCompat="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintStart_toEndOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/exo_ffwd"
        style="@style/PlayerHeroButton"
        android:layout_marginStart="32dp"
        app:srcCompat="@drawable/ic_forward"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintStart_toEndOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <ImageButton
        android:id="@+id/player_play_mode_button"
        style="@style/PlayerIconButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="48dp"
        android:padding="9dp"
        android:contentDescription="@string/player_mode_repeat_all"
        app:srcCompat="@drawable/ic_repeat"
        app:tint="@color/player_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause" />

    <ToggleButton
        android:id="@+id/player_skip_silence_toggle_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        android:background="@drawable/button_skip_silence_selector"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="@+id/exo_play_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause" />

    <LinearLayout
        android:id="@+id/player_sleep_timer_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/player_sleep_timer_button"
            style="@style/PlayerIconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:srcCompat="@drawable/ic_timer" />

        <TextView
            android:id="@+id/player_sleep_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_output_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_quick_action_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/player_capsule_bar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintWidth_max="520dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/player_open_lyrics_button"
                style="@style/PlayerCapsuleAction"
                android:contentDescription="@string/editorial_player_capsule_lyrics">

                <ImageView
                    android:id="@+id/player_capsule_lyrics_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_lyrics"
                    app:tint="@color/player_foreground"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/player_capsule_lyrics_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/player_foreground"
                    android:text="@string/editorial_player_capsule_lyrics" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_capsule_output_button"
                style="@style/PlayerCapsuleAction"
                android:contentDescription="@string/editorial_player_capsule_output">

                <ImageView
                    android:id="@+id/player_capsule_output_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_speaker"
                    app:tint="@color/player_foreground"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/player_capsule_output_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/player_foreground"
                    android:text="@string/editorial_player_capsule_output" />

                <View
                    android:id="@+id/player_capsule_output_dot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_capsule_sound_button"
                style="@style/PlayerCapsuleAction"
                android:contentDescription="@string/editorial_player_capsule_sound">

                <ImageView
                    android:id="@+id/player_capsule_sound_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_graphic_eq"
                    app:tint="@color/player_foreground"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/player_capsule_sound_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:fontFeatureSettings="tnum"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/player_foreground"
                    android:text="@string/editorial_player_capsule_sound" />

                <View
                    android:id="@+id/player_capsule_sound_dot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_open_queue_button"
                style="@style/PlayerCapsuleAction"
                android:contentDescription="@string/editorial_player_capsule_queue">

                <ImageView
                    android:id="@+id/player_capsule_queue_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_queue"
                    app:tint="@color/player_foreground"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/player_capsule_queue_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/player_foreground"
                    android:text="@string/editorial_player_capsule_queue" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
